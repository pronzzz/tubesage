PROJECT_NAME=TubeSage
API_V1_STR=/api/v1

# Database
POSTGRES_USER=tubesage
POSTGRES_PASSWORD=tubesage_secret
POSTGRES_DB=tubesage_db
DATABASE_URL=postgresql+asyncpg://tubesage:tubesage_secret@db:5432/tubesage_db

# Redis
REDIS_URL=redis://redis:6379/0

# YouTube API
YOUTUBE_API_KEY=your_api_key_here
OAUTH_CLIENT_SECRETS_FILE=client_secrets.json
